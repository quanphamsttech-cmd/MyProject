@using MyProject.Web.Startup
@using MyProject.Web.Models.AdmissionPeriods
@model AdmissionPeriodListViewModel

@{
    ViewBag.Title = L("AdmissionPeriods");
    ViewBag.CurrentPageName = PageNames.AdmissionPeriods;
}

@section scripts
{
    <environment names="Development">
        <script src="~/view-resources/Views/AdmissionPeriods/Index.js"
                asp-append-version="true"></script>
    </environment>

    <environment names="Staging,Production">
        <script src="~/view-resources/Views/AdmissionPeriods/Index.min.js"
                asp-append-version="true"></script>
    </environment>
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1>@L("AdmissionPeriods")</h1>
            </div>

            <div class="col-sm-6">
                <a href="javascript:;"
                   data-bs-toggle="modal"
                   data-bs-target="#AdmissionPeriodCreateModal"
                   class="btn bg-blue float-sm-right">

                    <i class="fa fa-plus-square"></i>
                    @L("Create")
                </a>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">

                    <div class="card-body">
                        <div class="table-responsive">

                           <table id="AdmissionPeriodsTable" class="table table-striped table-bordered">
    <thead>
        <tr>
            <th></th>
            <th>@L("Name")</th>
            <th>@L("SchoolYear")</th>
            <th>@L("StartDate")</th>
            <th>@L("EndDate")</th>
            <th>@L("IsActive")</th>
            <th style="width: 150px">@L("Actions")</th>
        </tr>
    </thead>

    <tbody></tbody>
</table>

                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

@await Html.PartialAsync(
    "~/Views/AdmissionPeriods/_CreateModal.cshtml",
    Model
)

<div class="modal fade"
     id="AdmissionPeriodEditModal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="AdmissionPeriodEditModalLabel">

    <div class="modal-dialog modal-lg" role="document">

        <div class="modal-content">
        </div>

    </div>
</div>