@{
    ViewBag.Title = "Quản Lý Tuyển sinh";
}

<div class="container-fluid">

    <!-- TIÊU ĐỀ -->
    <div class="row mb-4">
        <div class="col-12">
            <h2>
                <i class="fa fa-dashboard"></i>
                Quản Lý Tuyển sinh
            </h2>
            <p class="text-muted">
                Tổng quan tình hình quản lý chỉ tiêu tuyển sinh
            </p>
        </div>
    </div>

    <!-- THỐNG KÊ -->
    <div class="row">

        <!-- TỔNG CHỈ TIÊU -->
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card shadow-sm border-left-primary">
                <div class="card-body">
                    <div class="text-muted">
                        Tổng chỉ tiêu
                    </div>

                    <h2 class="mt-2">
                     @ViewBag.TotalQuota
                    </h2>

                    <i class="fa fa-users fa-2x text-primary"
                       style="float:right;"></i>
                </div>
            </div>
        </div>

        <!-- ĐÃ TUYỂN -->
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card shadow-sm border-left-success">
                <div class="card-body">
                    <div class="text-muted">
                        Đã tuyển
                    </div>

                    <h2 class="mt-2">
                        @ViewBag.TotalEnrolled
                    </h2>

                    <i class="fa fa-user-plus fa-2x text-success"
                       style="float:right;"></i>
                </div>
            </div>
        </div>

        <!-- CÒN LẠI -->
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card shadow-sm border-left-warning">
                <div class="card-body">
                    <div class="text-muted">
                        Còn lại
                    </div>

                    <h2 class="mt-2">
                        @ViewBag.TotalRemaining
                    </h2>

                    <i class="fa fa-bar-chart fa-2x text-warning"
                       style="float:right;"></i>
                </div>
            </div>
        </div>

        <!-- CHỜ DUYỆT -->
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card shadow-sm border-left-danger">
                <div class="card-body">
                    <div class="text-muted">
                        Chờ duyệt
                    </div>

                    <h2 class="mt-2">
                        @ViewBag.PendingCount
                    </h2>

                    <i class="fa fa-clock-o fa-2x text-danger"
                       style="float:right;"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- NÚT CHỨC NĂNG NHANH -->
    <div class="row mb-4">

        <div class="col-12">
            <div class="card shadow-sm">

                <div class="card-header">
                    <strong>
                        <i class="fa fa-bolt"></i>
                        Chức năng nhanh
                    </strong>
                </div>

                <div class="card-body">

                    <a href="@Url.Action("Create", "AdmissionQuota")"
                       class="btn btn-primary mr-2">
                        <i class="fa fa-plus"></i>
                        Thêm chỉ tiêu
                    </a>

                    <a href="@Url.Action("Index", "AdmissionQuota")"
                       class="btn btn-info mr-2">
                        <i class="fa fa-list"></i>
                        Quản lý chỉ tiêu
                    </a>

                </div>

            </div>
        </div>

    </div>

    <!-- NỘI DUNG -->
    <div class="row">

        <!-- CHỈ TIÊU THEO NGÀNH -->
        <div class="col-lg-8 mb-4">

            <div class="card shadow-sm">

                <div class="card-header">
                    <strong>
                        <i class="fa fa-bar-chart"></i>
                        Chỉ tiêu theo ngành
                    </strong>
                </div>

                <div class="card-body">

                    <table class="table table-bordered">

                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Ngành</th>
                                <th>Chỉ tiêu</th>
                                <th>Đã tuyển</th>
                                <th>Còn lại</th>
                            </tr>
                        </thead>

                        <tbody>

                            <tr>
                                <td>1</td>
                                <td>Công nghệ thông tin</td>
                                <td>100</td>
                                <td>30</td>
                                <td>70</td>
                            </tr>

                            <tr>
                                <td>2</td>
                                <td>Luật</td>
                                <td>50</td>
                                <td>20</td>
                                <td>30</td>
                            </tr>

                            <tr>
                                <td>3</td>
                                <td>Nghệ thuật</td>
                                <td>90</td>
                                <td>10</td>
                                <td>80</td>
                            </tr>

                            <tr>
                                <td>4</td>
                                <td>Quan hệ công chúng</td>
                                <td>40</td>
                                <td>5</td>
                                <td>35</td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <!-- TRẠNG THÁI DUYỆT -->
        <div class="col-lg-4 mb-4">

            <div class="card shadow-sm">

                <div class="card-header">
                    <strong>
                        <i class="fa fa-check-circle"></i>
                        Trạng thái chỉ tiêu
                    </strong>
                </div>

                <div class="card-body">

                    <div class="mb-3">
                        <span class="badge badge-secondary">
                            Nháp
                        </span>

                        <strong class="float-right">
                            5
                        </strong>
                    </div>

                    <div class="mb-3">
                        <span class="badge badge-warning">
                            Chờ duyệt
                        </span>

                        <strong class="float-right">
                            15
                        </strong>
                    </div>

                    <div class="mb-3">
                        <span class="badge badge-success">
                            Đã duyệt
                        </span>

                        <strong class="float-right">
                            25
                        </strong>
                    </div>

                    <div>
                        <span class="badge badge-danger">
                            Từ chối
                        </span>

                        <strong class="float-right">
                            3
                        </strong>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>